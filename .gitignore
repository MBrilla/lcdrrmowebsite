# ==============================================================================
# Git Ignore Configuration - Lipa CDRRMO Website
# ==============================================================================

# Dependencies & Package Managers
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Caches
/.next/
/out/
/build/
/dist/
/.turbo/
/.cache/

# Testing & Coverage
/coverage/
*.lcov

# Environment Variables & Secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt

# Vercel & Deployment Caches
.vercel

# TypeScript & Compilers
*.tsbuildinfo
next-env.d.ts

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/

# Editor & IDE Files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Temporary, Scratch & Local Backup Folders
*_backup/
*backup*/
public/personnel_backup/
scratch/
scratch_*
*.scratch.*
test_*.js
test_*.mjs
test_*.html
fb_output.html
*.bak
*.tmp
*.temp
